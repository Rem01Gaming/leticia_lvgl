prefix=./android/arm64-v8a
exec_prefix=${prefix}
libdir=./android/arm64-v8a/lib
includedir=./android/arm64-v8a/include

Name: libavcodec
Description: FFmpeg codec library
Version: 63.8.101
Requires: libswresample >= 7.2.100, libavutil >= 61.6.100
Requires.private: 
Conflicts:
Libs: -L${libdir}  -lavcodec -pthread -lm -latomic -lz
Libs.private: 
Cflags: -I${includedir}
